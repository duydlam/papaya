{
  "name": "papaya",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "nx run-many -t serve -p api web --parallel=2",
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test",
    "format": "prettier --write \"apps/**/*.{ts,tsx,json,css,mjs}\" \".vscode/*.json\" \".github/**/*.{yml,yaml}\" \"k8s/**/*.{yml,yaml}\" \"*.{json,yml,yaml,mjs,cjs}\" README.md",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,json,css,mjs}\" \".vscode/*.json\" \".github/**/*.{yml,yaml}\" \"k8s/**/*.{yml,yaml}\" \"*.{json,yml,yaml,mjs,cjs}\" README.md",
    "commit": "cz",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.0.0",
    "husky": "^9.1.7",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.5.2",
    "nx": "24.0.4",
    "postcss": "^8.5.32",
    "prettier": "^3.6.0",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.1"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "packageManager": "pnpm@11.28.4",
  "engines": {
    "node": ">=22.14.0 <23",
    "pnpm": "11.28.4"
  }
}
