{
  "name": "api",
  "root": "apps/api",
  "sourceRoot": "apps/api/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc -p apps/api/tsconfig.app.json" },
      "outputs": ["{workspaceRoot}/dist/apps/api"]
    },
    "start": {
      "executor": "nx:run-commands",
      "options": { "command": "node dist/apps/api/main.js" }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register apps/api/src/main.ts"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "eslint apps/api/src" }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "jest --config apps/api/jest.config.ts --runInBand"
      }
    }
  }
}
